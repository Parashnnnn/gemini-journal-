# Google Cloud Secret Manager & Environment Variables
# The frontend NEVER receives or stores these secrets.
# All operations are executed server-side in the backend proxy.

# GEMINI_API_KEY: Required for server-side Gemini AI model interactions.
# Stored in Google Cloud Secret Manager (e.g., 'gemini-api-key') and accessed at runtime.
GEMINI_API_KEY=""

# FIREBASE_PROJECT_ID: Google Cloud / Firebase Project ID used to verify Firebase ID tokens server-side.
FIREBASE_PROJECT_ID="gen-lang-client-0422068072"

# APP_URL: The URL where this application is hosted.
APP_URL="http://localhost:3000"

# PORT: Listening port for the backend server (Container port 3000).
PORT=3000
